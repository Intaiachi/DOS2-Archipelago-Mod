                            <attribute id="Act" value="0" type="4" />
                            <attribute id="Description" value="It seems there have been strange events unfolding at the excavation site - inexplicable visions and sensations have assailed those working down here, unnerving them. Just what kind of power is at work down here...?" handle="h594c1a68gd22ag49fcgb776g53278cc41da4" type="28" />
