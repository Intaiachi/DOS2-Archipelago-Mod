                            <attribute id="MysteryAction" value="4" type="1" />
                            <attribute id="MysteryDescription" value="I came to the Wellspring to become Divine and save the world from the Void. Instead, Dallis and Vredeman stole the powers of the Seven and left the island crumbling." handle="hea971c0dgc0a5g4532g9b6ag6793a55a27e4" type="28" />
