                        <node id="QuestState">
                            <attribute id="Achievement" value="" type="22" />
                            <attribute id="Act" value="19" type="4" />
                            <attribute id="Description" value="Lord Arhu has told us what he knows about entering the Tomb of Lucian. First, we will need a Source-filled Amulet and the Scroll of Atonement in order to get past the Path of Blood. Later, we will need to pull a sequence of named levers, the initials of which will spell out &apos;P.O.W.E.R&apos;. Beyond that, there may be further obstacles that he cannot help us with." handle="h800970a9g6fbag4afdg88afg3ba7bc0e0c2b" type="28" />
                            <attribute id="DevComment" value="" type="22" />
